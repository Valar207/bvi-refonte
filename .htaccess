# Liens directs et aperçus de partage : / et /projet/... passent par page.php ; plan du site dynamique.
# (le script ne s'appelle pas projet.php : avec MultiViews, actif chez OVH et utile aux images sans extension, /projet/... irait directement dessus)
DirectoryIndex page.php index.php index.html
RewriteEngine On
RewriteRule ^$ page.php [L]
RewriteRule ^projet/(.*)$ page.php?p=$1 [L,QSA,B]
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Pages, scripts et styles toujours revérifiés (le site change souvent ; content.js est réécrit par l'administration)
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|content\.js|data\.js|app\.js|style\.css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
